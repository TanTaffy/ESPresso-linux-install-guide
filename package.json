{
  "name": "espresso-desktop",
  "version": "2.0.0",
  "description": "ESPresso: visual FreeRTOS layouts and ESP-IDF C++ skeletons",
  "author": "ESPresso",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "build:ui": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build": "npm run native && npm run build:ui",
    "start": "node scripts/launch.mjs",
    "dev": "npm run build && npm start",
    "test": "npm run native && node --test tests/backend.test.mjs tests/firmware.test.mjs tests/roundtrip.test.mjs tests/runtime-config.test.mjs tests/imported.test.mjs tests/skeleton.test.mjs tests/editor.test.mjs tests/updates.test.mjs tests/http.test.mjs tests/native-paths.test.mjs tests/developer-tools.test.mjs tests/distribution.test.mjs",
    "test:e2e": "node tests/flow.e2e.mjs && node tests/desktop.e2e.mjs && node tests/project.e2e.mjs && node tests/features.e2e.mjs && node tests/themes.e2e.mjs && node tests/recovery.e2e.mjs && node tests/updates.e2e.mjs",
    "test:idf": "npm run native && node scripts/validate-idf.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "npmRebuild": false,
    "appId": "uk.espresso.desktop",
    "productName": "ESPresso",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/native/bin/Release",
        "to": "core",
        "filter": [
          "espresso-core",
          "espresso-core.exe"
        ]
      },
      {
        "from": "native/third_party/nlohmann/LICENSE.MIT",
        "to": "licenses/nlohmann-json.LICENSE.txt"
      },
      {
        "from": "native/third_party/icarus/LICENSE",
        "to": "licenses/icarus.LICENSE.txt"
      },
      {
        "from": "native/third_party/curl/COPYING",
        "to": "licenses/curl.LICENSE.txt"
      },
      {
        "from": "LICENSE",
        "to": "licenses/ESPresso.LICENSE.txt"
      },
      {
        "from": "public/brand/espresso-mark.png",
        "to": "branding/espresso-mark.png"
      },
      {
        "from": "defaults",
        "to": "defaults"
      },
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "branding/espresso.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "ESPresso-${version}-Windows.exe"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.developer-tools",
      "icon": "public/brand/espresso-mark.png",
      "artifactName": "ESPresso-${version}-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "linux": {
      "target": "tar.gz",
      "category": "Development",
      "icon": "public/brand/espresso-mark.png",
      "executableName": "espresso-desktop",
      "artifactName": "ESPresso-${version}-Linux-${arch}.${ext}"
    }
  }
}
